# All keys optional — Reclaim runs fully in mock mode without any of them.

# Google AI Studio (free tier): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash). Each model has its
# own free-tier quota bucket — switch to gemini-2.5-flash-lite if one drains.
GEMINI_MODEL=

# Razorpay test mode: Dashboard -> switch to Test Mode -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
